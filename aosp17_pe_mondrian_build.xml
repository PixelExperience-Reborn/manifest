  <!-- PE-Reborn AOSP 17 / mondrian (SM8475): REAL BUILD profile.
       Opt-in, used only by .github/workflows/aosp17-mondrian-build.yml on the
       project's own ServerHive runner. It extends the reviewed source-audit
       graph (official android-17.0.0_r1 plus reviewed PE forks) with the
       current bring-up heads of the mondrian device trees and of the
       Xiaomi/Qualcomm kernel, external modules and device trees that the
       kernel CI built together (Image, MODPOST, DT driver coverage).
       Qualcomm source HALs, vendor/xiaomi/* and hardware/xiaomi are added
       one at a time, each validated by this build. Not a release. -->
  <include name="aosp17_pe_mondrian_source_audit.xml" />

